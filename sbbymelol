local HitboxTab = Window:CreateTab("Hitbox", 4483362458)

local HB = {
    On = false,
    Size = 10,
    Transparency = 0.5,
    Color = Color3.fromRGB(255, 60, 60),
    TeamCheck = false,
    NPCs = false,
    MaxDistance = 0,            -- 0 = no limit
    Parts = { "Head" },
}

-- every group lists R15 and R6 names, only the ones that exist get used
local PartGroups = {
    ["Head"] = { "Head" },
    ["Torso"] = { "UpperTorso", "Torso" },
    ["HumanoidRootPart"] = { "HumanoidRootPart" },
    ["Arms"] = { "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm" },
    ["Legs"] = { "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" },
}

local Originals = setmetatable({}, { __mode = "k" })  -- [part] = saved properties
local Affected = setmetatable({}, { __mode = "k" })   -- [model] = true
local NPCModels = {}                                  -- [model] = true
local NPCConns = {}

--------------------------------------------------------------------
-- restore helpers
--------------------------------------------------------------------
local function RestorePart(part)
    local o = Originals[part]
    if not o then return end
    Originals[part] = nil
    if part.Parent then
        pcall(function()
            part.Size = o.Size
            part.Transparency = o.Transparency
            part.Color = o.Color
            part.CanCollide = o.CanCollide
            part.CanQuery = o.CanQuery
            part.CanTouch = o.CanTouch
        end)
    end
end

local function RestoreModel(model)
    for part, o in pairs(Originals) do
        if o.Model == model then RestorePart(part) end
    end
    Affected[model] = nil
end

local function RestoreAll()
    for part in pairs(Originals) do RestorePart(part) end
    table.clear(Affected)
end

--------------------------------------------------------------------
-- apply helpers
--------------------------------------------------------------------
local function ShouldAffect(plr)
    if plr == LocalPlayer then return false end
    if HB.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then return false end
    return true
end

local function InRange(model)
    if HB.MaxDistance <= 0 then return true end
    local mine = GetRoot()
    local theirs = model:FindFirstChild("HumanoidRootPart")
    if not (mine and theirs) then return true end
    return (theirs.Position - mine.Position).Magnitude <= HB.MaxDistance
end

local function ApplyToPart(part, model)
    if not Originals[part] then
        Originals[part] = {
            Model = model,
            Size = part.Size, Transparency = part.Transparency, Color = part.Color,
            CanCollide = part.CanCollide, CanQuery = part.CanQuery, CanTouch = part.CanTouch,
        }
    end
    local size = Vector3.new(HB.Size, HB.Size, HB.Size)
    if part.Size ~= size then part.Size = size end
    part.Transparency = HB.Transparency
    part.Color = HB.Color
    part.CanCollide = false
    part.CanQuery = true
    part.CanTouch = true
end

local function ApplyToModel(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or not InRange(model) then
        if Affected[model] then RestoreModel(model) end
        return
    end
    Affected[model] = true
    for _, group in ipairs(HB.Parts) do
        for _, name in ipairs(PartGroups[group] or {}) do
            local part = model:FindFirstChild(name)
            if part and part:IsA("BasePart") then pcall(ApplyToPart, part, model) end
        end
    end
end

--------------------------------------------------------------------
-- NPC tracking (event based, no repeated full-workspace scans)
--------------------------------------------------------------------
local function NPCFromHumanoid(inst)
    if not inst:IsA("Humanoid") then return nil end
    local m = inst.Parent
    if m and m:IsA("Model") and m ~= GetChar() and not Players:GetPlayerFromCharacter(m) then
        return m
    end
end

local function StopNPCTracking()
    for _, c in ipairs(NPCConns) do c:Disconnect() end
    table.clear(NPCConns)
    for model in pairs(NPCModels) do
        RestoreModel(model)
        NPCModels[model] = nil
    end
end

local function StartNPCTracking()
    StopNPCTracking()
    for _, inst in ipairs(workspace:GetDescendants()) do
        local m = NPCFromHumanoid(inst)
        if m then NPCModels[m] = true end
    end
    table.insert(NPCConns, workspace.DescendantAdded:Connect(function(inst)
        local m = NPCFromHumanoid(inst)
        if m then NPCModels[m] = true end
    end))
    table.insert(NPCConns, workspace.DescendantRemoving:Connect(function(inst)
        if inst:IsA("Humanoid") and inst.Parent then NPCModels[inst.Parent] = nil end
    end))
end

--------------------------------------------------------------------
-- loops
--------------------------------------------------------------------
-- single update loop
RunService.Heartbeat:Connect(function()
    if not HB.On then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if plr ~= LocalPlayer and char then
            if ShouldAffect(plr) then
                ApplyToModel(char)
            elseif Affected[char] then
                RestoreModel(char)
            end
        end
    end
    if HB.NPCs then
        for model in pairs(NPCModels) do
            if model.Parent then ApplyToModel(model) else NPCModels[model] = nil end
        end
    end
end)

-- big parts collide with the floor on YOUR client and pin the player in place,
-- so every part of an affected character has collisions turned off
RunService.Stepped:Connect(function()
    if not HB.On then return end
    for model in pairs(Affected) do
        if model.Parent then
            for _, p in ipairs(model:GetChildren()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        else
            Affected[model] = nil
        end
    end
end)

