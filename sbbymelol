    end
end)
local F_Effects = NewFeature(function(i, set)
    if i:IsA("PostEffect") then set(i, "Enabled", false)
    elseif i:IsA("Atmosphere") then set(i, "Density", 0) set(i, "Haze", 0)
    elseif i:IsA("Clouds") then set(i, "Enabled", false) end
end)
