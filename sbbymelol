local OptTab = Window:CreateTab("Optimization", 4483362458)
local FeatureList = {}

local function NewFeature(applyFn)
    local f = { Enabled = false, Saved = setmetatable({}, { __mode = "k" }) }
    f.Set = function(inst, prop, value)
        local ok, current = pcall(function() return inst[prop] end)
        if not ok then return end
        local s = f.Saved[inst]
        if not s then s = {} f.Saved[inst] = s end
        if s[prop] == nil then s[prop] = current end
        pcall(function() inst[prop] = value end)
    end
    f.Apply = function(inst) applyFn(inst, f.Set) end
    table.insert(FeatureList, f)
    return f
end

local function RestoreFeature(f)
    for inst, props in pairs(f.Saved) do
        for prop, val in pairs(props) do pcall(function() inst[prop] = val end) end
    end
    f.Saved = setmetatable({}, { __mode = "k" })
end

local function EnableFeature(f)
    f.Enabled = true
    task.spawn(function()
        local n = 0
        for _, root in { workspace, Lighting } do
            for _, inst in ipairs(root:GetDescendants()) do
                if not f.Enabled then return end
                pcall(f.Apply, inst)
                n += 1
                if n % 1000 == 0 then task.wait() end
            end
        end
    end)
end

local function DisableFeature(f)
    f.Enabled = false
    RestoreFeature(f)
end

local function OnAdded(inst)
    for _, f in ipairs(FeatureList) do
        if f.Enabled then pcall(f.Apply, inst) end
    end
end
workspace.DescendantAdded:Connect(OnAdded)
Lighting.DescendantAdded:Connect(OnAdded)

