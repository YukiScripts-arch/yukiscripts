OptTab:CreateSection("Screen shake")

local NoShake = false
local ShakeDisabled = {}

local function KillShakeConnections()
    if not getconnections then return end
    local ev = ReplicatedStorage:FindFirstChild("ShakeEvent")
    if not ev then return end
    for _, c in ipairs(getconnections(ev.OnClientEvent)) do
        pcall(function() c:Disable() end)
        table.insert(ShakeDisabled, c)
    end
end

local function EnableShakeBlock()
    KillShakeConnections()
    pcall(function() RunService:UnbindFromRenderStep("NoScreenShake") end)
    RunService:BindToRenderStep("NoScreenShake", Enum.RenderPriority.Camera.Value - 1, function()
        local hum = GetHum()
        if hum and hum.CameraOffset ~= Vector3.zero then hum.CameraOffset = Vector3.zero end
    end)
end

local function DisableShakeBlock()
    pcall(function() RunService:UnbindFromRenderStep("NoScreenShake") end)
    for _, c in ipairs(ShakeDisabled) do pcall(function() c:Enable() end) end
    table.clear(ShakeDisabled)
end

OptTab:CreateToggle({
    Name = "No screen shake", CurrentValue = false, Flag = "OptNoShake",
    Callback = function(Value)
        NoShake = Value
        if Value then EnableShakeBlock() else DisableShakeBlock() end
    end,
})

LocalPlayer.CharacterAdded:Connect(function()
    if not NoShake then return end
    for _ = 1, 4 do
        task.wait(0.75)
        if not NoShake then return end
        KillShakeConnections()
