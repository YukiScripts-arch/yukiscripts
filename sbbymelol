local MAX = 500
local Busy = false
local Running = false
local Cancelled = false
local AutoId = 0
local HoldTime = 0.6
local Delay = 0.05

local function GetChar() return LocalPlayer.Character end
local function GetRoot()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function GetCandyValue()
    local v = LocalPlayer:FindFirstChild("Candies")
    return v and v.Value or 0
end
local function GetCandies()
    local Folder = workspace:FindFirstChild("Candies")
    local list = {}
    if Folder then
        for _, obj in Folder:GetChildren() do
            if obj:IsA("BasePart") and obj.Name:lower() == "candycorn" then
                table.insert(list, obj)
            end
        end
    end
    return list
end
local function TouchWithAllParts(Target)
    local char = GetChar()
    if not (char and firetouchinterest) then return end
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") and Target.Parent then
            firetouchinterest(part, Target, 0)
            firetouchinterest(part, Target, 1)
        end
    end
end
local function Collected(Candy, before)
    return (not Candy.Parent) or GetCandyValue() > before
end

--------------------------------------------------------------------
-- CANDY COLLECT (teleport)
--------------------------------------------------------------------
local function TeleportToCandy(Candy)
    local before = GetCandyValue()
    local t = os.clock()
    while os.clock() - t < HoldTime do
        local Root = GetRoot()
        if Cancelled or not Root then return false end
        if Collected(Candy, before) then return true end
        Root.CFrame = Candy.CFrame
        Root.AssemblyLinearVelocity = Vector3.zero
        TouchWithAllParts(Candy)
        task.wait(0.05)
    end
    return Collected(Candy, before)
end

local Status
local function UpdateStatus()
    if Status then Status:Set("Candy Corn: " .. GetCandyValue() .. " / " .. MAX) end
end

local function CollectAll()
    if Busy then return 0 end
    Busy = true
    Cancelled = false
    local startValue = GetCandyValue()
    local Root = GetRoot()
    local origin = Root and Root.CFrame

    for _, Candy in GetCandies() do
        if Cancelled or GetCandyValue() >= MAX or not GetRoot() then break end
        if Candy.Parent then TeleportToCandy(Candy) end
        UpdateStatus()
        task.wait(Delay)
    end

    local R = GetRoot()
    if R and origin then
        R.CFrame = origin
        R.AssemblyLinearVelocity = Vector3.zero
    end
    UpdateStatus()
    Busy = false
    return GetCandyValue() - startValue
end

