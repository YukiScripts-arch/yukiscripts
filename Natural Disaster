--// Anti-Fling logic
local FlingActive = false -- set by the Player > Fling toggle (pauses anti-fling while fling is on)

local AntiFling = {
	Enabled = false,
	NoCollide = true,
	NoCollideSelf = true,
	VelocityLimit = 80,
	LockAngular = true,
	Connections = {},
	OriginalCollide = setmetatable({}, { __mode = "k" }),
	LastSafeCFrame = nil,
}

local function getRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function setOthersCollision(state)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			for _, part in ipairs(plr.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					if not state then
						-- remember original value, then disable
						if AntiFling.OriginalCollide[part] == nil then
							AntiFling.OriginalCollide[part] = part.CanCollide
						end
						part.CanCollide = false
					else
						local orig = AntiFling.OriginalCollide[part]
						if orig ~= nil then
							part.CanCollide = orig
							AntiFling.OriginalCollide[part] = nil
						end
					end
				end
			end
		end
	end
end

local function setSelfCollision(state)
	local char = LocalPlayer.Character
	if not char then
		return
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if not state then
				if AntiFling.OriginalCollide[part] == nil then
					AntiFling.OriginalCollide[part] = part.CanCollide
				end
				part.CanCollide = false
			else
				local orig = AntiFling.OriginalCollide[part]
				if orig ~= nil then
					part.CanCollide = orig
					AntiFling.OriginalCollide[part] = nil
				end
			end
		end
	end
end

local function onStepped()
	if FlingActive then
		return
	end
	if AntiFling.NoCollide then
		setOthersCollision(false)
	end
	if AntiFling.NoCollideSelf then
		setSelfCollision(false)
	end
end

local function onHeartbeat()
	-- don't fight Fling / Fly, they intentionally change your velocity
	if FlingActive or (Toggles.FlyToggle and Toggles.FlyToggle.Value) then
		return
	end
	local root = getRoot()
	if not root then
		return
	end

	local vel = root.AssemblyLinearVelocity
	local ang = root.AssemblyAngularVelocity

	-- flung: speed way above normal or crazy spin -> reset and go back to last safe spot
	local tooFast = vel.Magnitude > AntiFling.VelocityLimit and (math.abs(vel.Y) > AntiFling.VelocityLimit or Vector3.new(vel.X, 0, vel.Z).Magnitude > AntiFling.VelocityLimit)
	local tooSpin = AntiFling.LockAngular and ang.Magnitude > 50

	if tooFast or tooSpin then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		if AntiFling.LastSafeCFrame then
			root.CFrame = AntiFling.LastSafeCFrame
		end
	else
		AntiFling.LastSafeCFrame = root.CFrame
	end
end

local function enableAntiFling()
	if AntiFling.Enabled then
		return
	end
	AntiFling.Enabled = true
	table.insert(AntiFling.Connections, RunService.Stepped:Connect(onStepped))
	table.insert(AntiFling.Connections, RunService.Heartbeat:Connect(onHeartbeat))
end

local function disableAntiFling()
	AntiFling.Enabled = false
	for _, c in ipairs(AntiFling.Connections) do
		c:Disconnect()
	end
	table.clear(AntiFling.Connections)
	setOthersCollision(true)
	setSelfCollision(true)
end

