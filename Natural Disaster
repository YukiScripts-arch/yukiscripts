--// Super Ring tab (optimized: array + swap-remove, batched updates, no per-part trig, chunked scan)
local Ring = {
	Enabled = false,
	List = {}, -- array of parts (fast numeric iteration)
	Index = {}, -- [part] = position in List
	Count = 0,
	Cursor = 1,
	Original = setmetatable({}, { __mode = "k" }),
	Connections = {},
	LastSim = 0,
	ScanToken = 0,
}

local mSin, mCos, mAbs, mMin, mSqrt = math.sin, math.cos, math.abs, math.min, math.sqrt
local v3 = Vector3.new

local function getOtherChars()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			list[#list + 1] = plr.Character
		end
	end
	return list
end

local function ringAdd(part, chars)
	if Ring.Index[part] or not part:IsA("BasePart") or part.Anchored then
		return
	end
	local myChar = LocalPlayer.Character
	if myChar and part:IsDescendantOf(myChar) then
		return
	end
	if not T("RingPlayers") then
		chars = chars or getOtherChars()
		for i = 1, #chars do
			if part:IsDescendantOf(chars[i]) then
				return
			end
		end
	end
	Ring.Original[part] = { Props = part.CustomPhysicalProperties, CanCollide = part.CanCollide }
	part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
	part.CanCollide = false
	local n = Ring.Count + 1
	Ring.Count = n
	Ring.List[n] = part
	Ring.Index[part] = n
end

local function ringRemove(part)
	local i = Ring.Index[part]
	if not i then
		return
	end
	local n = Ring.Count
	local last = Ring.List[n]
	Ring.List[i] = last
	Ring.Index[last] = i
	Ring.List[n] = nil
	Ring.Index[part] = nil
	Ring.Count = n - 1
end

local function ringRestoreAll()
	local list = Ring.List
	for i = 1, Ring.Count do
		local part = list[i]
		local orig = Ring.Original[part]
		if orig and part.Parent then
			part.CustomPhysicalProperties = orig.Props
			part.CanCollide = orig.CanCollide
		end
		Ring.Original[part] = nil
	end
	table.clear(Ring.List)
	table.clear(Ring.Index)
	Ring.Count = 0
	Ring.Cursor = 1
end

-- scan the workspace in chunks so enabling doesn't freeze the game
local function ringScan()
	Ring.ScanToken = Ring.ScanToken + 1
	local token = Ring.ScanToken
	task.spawn(function()
		local descendants = Workspace:GetDescendants()
		local chars = getOtherChars()
		for i = 1, #descendants do
			if token ~= Ring.ScanToken or not Ring.Enabled then
				return
			end
			ringAdd(descendants[i], chars)
			if i % 300 == 0 then
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

local function ringStep()
	-- refresh the simulation radius about once a second instead of every frame
	local now = os.clock()
	if sethiddenproperty and now - Ring.LastSim > 1 then
		Ring.LastSim = now
		pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
	end

	local count = Ring.Count
	if count == 0 then
		return
	end
	local root = getRoot()
	if not root then
		return
	end

	local center = root.Position
	local cx, cy, cz = center.X, center.Y, center.Z
	local radius = O("RingRadius", 50)
	local height = O("RingHeight", 100)
	local strength = O("RingStrength", 1000)
	local rot = math.rad(O("RingSpeed", 10))
	local cosR, sinR = mCos(rot), mSin(rot)

	local batch = O("RingBatch", 600)
	if batch > count then
		batch = count
	end

	local list = Ring.List
	local cursor = Ring.Cursor

	for _ = 1, batch do
		if cursor > count then
			cursor = 1
		end
		local part = list[cursor]
		cursor = cursor + 1

		if part.Parent and not part.Anchored then
			local pos = part.Position
			local px, py, pz = pos.X, pos.Y, pos.Z
			local dx, dz = px - cx, pz - cz
			local dist = mSqrt(dx * dx + dz * dz)

			-- rotate the horizontal offset by the rotation step (same as atan2 + angle, without trig per part)
			local scale = 0
			if dist > 0 then
				scale = mMin(radius, dist) / dist
			end
			local tx = cx + (dx * cosR - dz * sinR) * scale
			local tz = cz + (dx * sinR + dz * cosR) * scale
			local ty = cy + height * mAbs(mSin((py - cy) / height))

			local vx, vy, vz = tx - px, ty - py, tz - pz
			local mag = mSqrt(vx * vx + vy * vy + vz * vz)
			if mag > 0.001 then
				local k = strength / mag
				part.AssemblyLinearVelocity = v3(vx * k, vy * k, vz * k)
			end
		end
	end

	Ring.Cursor = cursor
end

local function ringEnable()
	if Ring.Enabled then
		return
	end
	Ring.Enabled = true
	pcall(function()
		LocalPlayer.ReplicationFocus = Workspace
	end)
	ringScan()
	table.insert(Ring.Connections, Workspace.DescendantAdded:Connect(function(p)
		ringAdd(p)
	end))
	table.insert(Ring.Connections, Workspace.DescendantRemoving:Connect(ringRemove))
	table.insert(Ring.Connections, RunService.Heartbeat:Connect(ringStep))
end

local function ringDisable()
	Ring.Enabled = false
	Ring.ScanToken = Ring.ScanToken + 1 -- cancels a scan in progress
	for _, c in ipairs(Ring.Connections) do
		c:Disconnect()
	end
	table.clear(Ring.Connections)
	ringRestoreAll()
end

