local function runRemote(name, url)
	Library:Notify({ Title = name, Description = "Loading...", Time = 2 })
	local ok, err = pcall(function()
		loadstring(game:HttpGet(url))()
	end)
	if not ok then
		warn(("[%s] failed to load: %s"):format(name, tostring(err)))
		Library:Notify({ Title = name, Description = "Failed to load (check console)", Time = 4 })
	end
end

