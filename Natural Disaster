			hum.HipHeight = O("HipSlider", 5)
		end
	end

	if T("GravityToggle") then
		Workspace.Gravity = O("GravitySlider", 100)
	end

	if T("FOVToggle") and Workspace.CurrentCamera then
		Workspace.CurrentCamera.FieldOfView = O("FOVSlider", 100)
	end

	-- Fly
	if T("FlyToggle") and hum and root then
		if not flyBV or flyBV.Parent ~= root then
			stopFly()
			flyBV = Instance.new("BodyVelocity")
			flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			flyBV.Velocity = Vector3.new(0, 0, 0)
			flyBV.Parent = root
		end
		local cam = Workspace.CurrentCamera
		local speed = O("FlySpeed", 60)
		local md = hum.MoveDirection
		local vel = md * speed
		if md.Magnitude > 0 and cam then
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0 then
				vel = vel + Vector3.new(0, look.Y * speed * md:Dot(flat.Unit), 0)
			end
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			vel = vel + Vector3.new(0, speed, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			vel = vel - Vector3.new(0, speed, 0)
		end
		flyBV.Velocity = vel
	end
end)

