do
    local Lighting = game:GetService("Lighting")
    local RunService = game:GetService("RunService")

    local modes = {
        Max = { fog = 1000000, brightness = 10, ambient = Color3.new(1, 1, 1) },
        Half = { fog = 250, brightness = 1.5, ambient = Color3.new(0.6, 0.6, 0.6) },
    }

    local orig = nil

    local function restore()
        if not orig then return end
        Lighting.Ambient = orig.ambient
        Lighting.OutdoorAmbient = orig.outdoor
        Lighting.Brightness = orig.brightness
        Lighting.FogStart = orig.fogStart
        Lighting.FogEnd = orig.fogEnd
        orig = nil
    end

    restoreExtras = restore

    local fbConn
    fbConn = RunService.RenderStepped:Connect(function()
        if rawget(_G, _G_TOMB) then
            fbConn:Disconnect()
            return
        end
        if Config.fullbright then
            if not orig then
                orig = {
                    ambient = Lighting.Ambient,
                    outdoor = Lighting.OutdoorAmbient,
                    brightness = Lighting.Brightness,
                    fogStart = Lighting.FogStart,
                    fogEnd = Lighting.FogEnd,
                }
            end
            local m = modes[Config.fullbrightMode] or modes.Max
            Lighting.Ambient = m.ambient
            Lighting.OutdoorAmbient = m.ambient
            Lighting.Brightness = m.brightness
            Lighting.FogStart = m.fog
            Lighting.FogEnd = m.fog
        elseif orig then
            restore()
        end
    end)
end

