        if UIS:GetFocusedTextBox() then return dir end
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            dir -= Vector3.yAxis
        end
        return dir
    end

    local function getHum()
        local c = LP.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function stopFly()
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
        local hum = getHum()
        if hum then hum.PlatformStand = false end
        flying = false
    end

    local function stopVFly()
        if vBV then vBV:Destroy(); vBV = nil end
        if vBG then vBG:Destroy(); vBG = nil end
    end

    restorePlayer = function()
        stopFly()
        stopVFly()
        workspace.Gravity = orig.gravity
        Camera.FieldOfView = orig.fov
        local hum = getHum()
        if hum then
            if applied.ws then hum.WalkSpeed = orig.ws or 16 end
            if applied.jp then
                hum.UseJumpPower = true
                hum.JumpPower = orig.jp or 50
            end
        end
    end

    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()
        if rawget(_G, _G_TOMB) then
            renderConn:Disconnect()
            return
        end

        Camera = workspace.CurrentCamera
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        -- WalkSpeed / JumpPower
        if hum then
            if Config.walkSpeedOn then
                if not applied.ws then orig.ws = hum.WalkSpeed; applied.ws = true end
                hum.WalkSpeed = Config.walkSpeed
            elseif applied.ws then
                hum.WalkSpeed = orig.ws or 16
                applied.ws = false
            end

            if Config.jumpPowerOn then
                if not applied.jp then orig.jp = hum.JumpPower; applied.jp = true end
                hum.UseJumpPower = true
                hum.JumpPower = Config.jumpPower
            elseif applied.jp then
                hum.UseJumpPower = true
                hum.JumpPower = orig.jp or 50
                applied.jp = false
            end
        end

        -- Gravity
        if Config.gravityOn then
            if not applied.grav then orig.gravity = workspace.Gravity; applied.grav = true end
            workspace.Gravity = Config.gravity
        elseif applied.grav then
            workspace.Gravity = orig.gravity
            applied.grav = false
        end

        -- FOV
        if Config.fovOn then
            if not applied.fov then orig.fov = Camera.FieldOfView; applied.fov = true end
            Camera.FieldOfView = Config.fov
        elseif applied.fov then
            Camera.FieldOfView = orig.fov
            applied.fov = false
        end

        -- Fly (BodyVelocity + BodyGyro)
        if Config.fly and root and hum and hum.Health > 0 then
            if not flyBV or flyBV.Parent ~= root then
                if flyBV then flyBV:Destroy() end
                if flyBG then flyBG:Destroy() end
                flyBV = Instance.new("BodyVelocity")
                flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBV.Velocity = Vector3.zero
                flyBV.Parent = root
                flyBG = Instance.new("BodyGyro")
                flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                flyBG.P = 9e4
                flyBG.CFrame = Camera.CFrame
                flyBG.Parent = root
            end

            hum.PlatformStand = true
            local cf = Camera.CFrame
            local dir = Vector3.zero
            if not UIS:GetFocusedTextBox() then
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
                    dir -= Vector3.yAxis
                end
            end
            flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * Config.flySpeed or Vector3.zero
            flyBG.CFrame = cf
            flying = true
        elseif flying then
            stopFly()
        end

        -- Vehicle fly (BodyVelocity + BodyGyro on the seated character)
        if Config.vfly and root and hum and hum.SeatPart then
            if not vBV or vBV.Parent ~= root then
                stopVFly()
                vBV = Instance.new("BodyVelocity")
                vBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                vBV.Velocity = Vector3.zero
                vBV.Parent = root
                vBG = Instance.new("BodyGyro")
                vBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                vBG.P = 9e4
                vBG.CFrame = Camera.CFrame
                vBG.Parent = root
            end
            local cf = Camera.CFrame
            local dir = moveDir(cf)
            vBV.Velocity = dir.Magnitude > 0 and dir.Unit * Config.vflySpeed or Vector3.zero
            vBG.CFrame = cf
        elseif vBV or vBG then
            stopVFly()
        end
    end)

    -- Noclip
    local steppedConn
    steppedConn = RunService.Stepped:Connect(function()
        if rawget(_G, _G_TOMB) then
            steppedConn:Disconnect()
            return
        end
        if (Config.noclip or Config.walkfling) and LP.Character then
            for _, part in ipairs(LP.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    -- Infinite jump
    local jumpConn
    jumpConn = UIS.JumpRequest:Connect(function()
        if rawget(_G, _G_TOMB) then
            jumpConn:Disconnect()
            return
        end
        if Config.infJump then
            local hum = getHum()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
end

-- Aimbot (hold RMB, or Auto Aim) ---------------------------------------
do
    local RunService = game:GetService("RunService")
    local UIS = game:GetService("UserInputService")

    parseIgnore(Config.aimIgnore)

    local function isVisible(origin, pos, targetChar)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = { LP.Character, Camera }
        for _ = 1, 15 do
            params.FilterDescendantsInstances = ignore
            local res = workspace:Raycast(origin, pos - origin, params)
            if not res then return true end
            if res.Instance:IsDescendantOf(targetChar) then return true end
            if res.Instance.CanCollide == false or res.Instance.Transparency >= 1 then
                table.insert(ignore, res.Instance)
            else
                return false
            end
        end
        return false
    end

    local aimConn
    aimConn = RunService.RenderStepped:Connect(function()
        if rawget(_G, _G_TOMB) then
            aimConn:Disconnect()
            return
        end
        if not Config.aimbot then return end

        local holding = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if not (holding or Config.aimAuto) then return end

        Camera = workspace.CurrentCamera
        local myChar = LP.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then return end

        local camCF = Camera.CFrame
        local bestPos, bestDot = nil, 0

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0
                    and not char:FindFirstChildOfClass("ForceField")
                    and not aimIgnoreSet[plr.Name:lower()]
                    and not aimIgnoreSet[plr.DisplayName:lower()]
                    and not (Config.aimTeamCheck and plr.Team and plr.Team == LP.Team) then

                    local part = (Config.aimHeadsOnly and char:FindFirstChild("Head")) or root
                    local pos = part.Position
                    local dot = (pos - camCF.Position).Unit:Dot(camCF.LookVector)
                    if dot > bestDot and (not Config.aimWallCheck or isVisible(camCF.Position, pos, char)) then
                        bestDot, bestPos = dot, pos
                    end
                end
            end
        end

        if bestPos then
            local alpha = math.clamp(Config.aimSmooth / 100, 0.01, 1)
            Camera.CFrame = camCF:Lerp(CFrame.lookAt(camCF.Position, bestPos), alpha)
        end
    end)
end

