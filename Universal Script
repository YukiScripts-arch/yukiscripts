task.spawn(function()
    local lagging = false
    while true do
        if rawget(_G, _G_TOMB) then break end
        task.wait(0.1)
        if net then
            pcall(function()
                if Config.backtrack then
                    lagging = true
                    local lo = math.floor(math.min(Config.backtrackMin, Config.backtrackMax))
                    local hi = math.floor(math.max(Config.backtrackMin, Config.backtrackMax))
                    net.IncomingReplicationLag = math.random(lo, hi) / 1000
                elseif lagging then
                    lagging = false
                    net.IncomingReplicationLag = 0
                end
            end)
        end
    end
    if net then pcall(function() net.IncomingReplicationLag = 0 end) end
end)

-- Ping & FPS display ---------------------------------------------------
task.spawn(function()
    local RunService = game:GetService("RunService")
    local Stats = game:GetService("Stats")
    local frames, last, fps = 0, tick(), 0
    local conn = RunService.RenderStepped:Connect(function()
        frames += 1
    end)

    while true do
        if rawget(_G, _G_TOMB) then break end
        task.wait(0.25)

        local now = tick()
        fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
        frames, last = 0, now

        pcall(function()
            if not (Config.showPing or Config.showFps) then
                if statsText then statsText.Visible = false end
                return
            end

            if not statsText then
                statsText = newDrawing("Text", {
                    Visible = false, Size = 16, Center = true, Outline = true, Font = 2,
                })
            end

            local ping = nil
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)
            if not ping then
                ping = math.floor(LP:GetNetworkPing() * 2000 + 0.5)
            end

            local parts = {}
            if Config.showFps then table.insert(parts, "FPS: " .. fps) end
            if Config.showPing then table.insert(parts, "Ping: " .. ping .. "ms") end

            statsText.Text = table.concat(parts, "  |  ")
            statsText.Position = Vector2.new(Camera.ViewportSize.X / 2, 8)
            statsText.Color = (Config.showPing and (ping > 200 and Color3.fromRGB(255, 60, 60)
                or ping > 100 and Color3.fromRGB(255, 200, 0)))
                or Color3.fromRGB(0, 255, 120)
            statsText.Visible = true
        end)
    end

    conn:Disconnect()
end)

