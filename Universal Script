local setclip = setclipboard or toclipboard or set_clipboard

local function parseNum(s)
    return tonumber((tostring(s or ""):gsub("[,%s]", "")))
end

local function findPlayer(text)
    text = (tostring(text or ""):match("^%s*(.-)%s*$") or ""):lower()
    if text == "" then return LP end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #text) == text or p.DisplayName:lower():sub(1, #text) == text then
            return p
        end
    end
    return nil
end

local function getRootPart(plr)
    local char = plr and plr.Character
