-- TAB: SAFE SPOT (far away 1000 x 1000 arena)
--------------------------------------------------------------------
local ARENA_SIZE = 1000          -- studs (X and Z)
local FloorThickness = 10
local WallHeight = 60
local WallThickness = 4
local ArenaDistance = 5000       -- how far from you the arena is built (X and Z)
local ArenaHeight = 500          -- Y position of the arena floor
local ArenaTransparency = 0.5

local ArenaFolder
local ArenaCenter
local ArenaOrigin                -- where you were when the arena was created
local SafeReturn                 -- CFrame to go back to
local OnSafe = false
local AutoKeep = false

local ArenaBox = Tabs.Safe:AddLeftGroupbox("Arena")
local TeleBox = Tabs.Safe:AddRightGroupbox("Teleport")
local SafeStatus = Label(ArenaBox, "Status: no arena created")

local function ArenaExists()
    return ArenaFolder ~= nil and ArenaFolder.Parent ~= nil
end

local function MakeArenaPart(name, size, position)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Position = position
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = false
    p.Material = Enum.Material.SmoothPlastic
    p.Color = Color3.fromRGB(80, 200, 120)
    p.Transparency = ArenaTransparency
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = ArenaFolder
    return p
end

local function CreateArena()
    if ArenaExists() then return end
    local root = GetRoot()
    local base = root and root.Position or Vector3.zero
    ArenaOrigin = Vector3.new(base.X, 0, base.Z)
    ArenaCenter = ArenaOrigin + Vector3.new(ArenaDistance, ArenaHeight, ArenaDistance)

    ArenaFolder = Instance.new("Folder")
    ArenaFolder.Name = "SafeArena"
    ArenaFolder.Parent = workspace

    local c = ArenaCenter
    local half = ARENA_SIZE / 2
    local wallY = c.Y + FloorThickness / 2 + WallHeight / 2
    local offset = half + WallThickness / 2

    MakeArenaPart("Floor", Vector3.new(ARENA_SIZE, FloorThickness, ARENA_SIZE), c)
    MakeArenaPart("WallN", Vector3.new(ARENA_SIZE + WallThickness * 2, WallHeight, WallThickness),
        Vector3.new(c.X, wallY, c.Z - offset))
    MakeArenaPart("WallS", Vector3.new(ARENA_SIZE + WallThickness * 2, WallHeight, WallThickness),
        Vector3.new(c.X, wallY, c.Z + offset))
    MakeArenaPart("WallE", Vector3.new(WallThickness, WallHeight, ARENA_SIZE),
        Vector3.new(c.X + offset, wallY, c.Z))
    MakeArenaPart("WallW", Vector3.new(WallThickness, WallHeight, ARENA_SIZE),
        Vector3.new(c.X - offset, wallY, c.Z))

    SafeStatus:Set("Status: arena created (" .. ARENA_SIZE .. "x" .. ARENA_SIZE .. ")")
end

local function RemoveArena()
    OnSafe = false
    if ArenaFolder then pcall(function() ArenaFolder:Destroy() end) end
    ArenaFolder = nil
    ArenaCenter = nil
    SafeStatus:Set("Status: no arena created")
end

local function ArenaTop()
    return ArenaCenter + Vector3.new(0, FloorThickness / 2 + 4, 0)
end

local function IsInArena(root)
    if not (ArenaExists() and ArenaCenter) then return false end
    local rel = root.Position - ArenaCenter
    local limit = ARENA_SIZE / 2 + WallThickness
    return math.abs(rel.X) <= limit and math.abs(rel.Z) <= limit and rel.Y > 0
end

-- moves the whole arena (and you, if you're standing on it)
local function MoveArena(newCenter)
    if not ArenaExists() then return end
    local delta = newCenter - ArenaCenter
    local root = GetRoot()
    local carry = OnSafe and root and IsInArena(root)
    for _, p in ipairs(ArenaFolder:GetChildren()) do
        if p:IsA("BasePart") then p.Position += delta end
    end
    ArenaCenter = newCenter
    if carry then
        root.CFrame += delta
        root.AssemblyLinearVelocity = Vector3.zero
    end
end

local function GoToSafe()
    local root = GetRoot()
    if not root then return end
    CreateArena()
    if not IsInArena(root) then SafeReturn = root.CFrame end
    root.CFrame = CFrame.new(ArenaTop())
    root.AssemblyLinearVelocity = Vector3.zero
    OnSafe = true
    SafeStatus:Set("Status: standing in the safe arena")
end

local function ReturnFromSafe()
    local root = GetRoot()
    OnSafe = false
    if root and SafeReturn then
        root.CFrame = SafeReturn
        root.AssemblyLinearVelocity = Vector3.zero
        SafeStatus:Set("Status: returned to previous position")
    end
end

ArenaBox:AddToggle("SafeCreate", {
    Text = "Create far-away arena (1000 x 1000 studs)", Default = false,
    Callback = function(Value)
        if Value then CreateArena() else RemoveArena() end
    end,
})
ArenaBox:AddSlider("ArenaDistance", {
    Text = "Distance from you (studs)", Default = 5000, Min = 1000, Max = 20000, Rounding = 0,
    Callback = function(v)
        ArenaDistance = v
        if ArenaExists() and ArenaOrigin then
            MoveArena(ArenaOrigin + Vector3.new(v, ArenaCenter.Y - 0, v))
        end
    end,
})
ArenaBox:AddSlider("ArenaHeight", {
    Text = "Arena height (Y)", Default = 500, Min = 50, Max = 5000, Rounding = 0,
    Callback = function(v)
        ArenaHeight = v
        if ArenaExists() then
            MoveArena(Vector3.new(ArenaCenter.X, v, ArenaCenter.Z))
        end
    end,
})
ArenaBox:AddSlider("ArenaTransparency", {
    Text = "Arena transparency", Default = 0.5, Min = 0, Max = 1, Rounding = 2,
    Callback = function(v)
        ArenaTransparency = v
        if ArenaExists() then
            for _, p in ipairs(ArenaFolder:GetChildren()) do
                if p:IsA("BasePart") then p.Transparency = v end
            end
        end
    end,
})

TeleBox:AddButton({ Text = "Teleport to safe arena", Func = GoToSafe })
TeleBox:AddButton({ Text = "Return to previous position", Func = ReturnFromSafe })
TeleBox:AddToggle("SafeKeep", {
    Text = "Keep me in the arena (re-teleport if I fall out)", Default = false,
    Callback = function(Value) AutoKeep = Value end,
})

task.spawn(function()
