-- the Candies value can sit directly on the player or inside leaderstats / another folder
local CandyValueObj
local function GetCandyValueObject()
    if CandyValueObj and CandyValueObj.Parent then return CandyValueObj end
    local v = LocalPlayer:FindFirstChild("Candies")
    if not v then
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        v = ls and ls:FindFirstChild("Candies")
    end
    if not v then v = LocalPlayer:FindFirstChild("Candies", true) end
    if v and v:IsA("ValueBase") then CandyValueObj = v return v end
    return nil
end
local function GetCandyValue()
    local v = GetCandyValueObject()
    return v and v.Value or 0
end

local function IsCandyName(name)
    name = name:lower()
    return name:find("candy") ~= nil or name:find("corn") ~= nil
end

-- finds every candy under workspace.Candies (parts, or parts inside candy models),
-- nearest to you first
local function GetCandies()
    local Folder = workspace:FindFirstChild("Candies")
    local list = {}
    if not Folder then return list end

    -- every direct child of workspace.Candies is a candy, whatever its name or class
    -- (the game sends the child itself in its collect event). Models/folders use their
    -- main part, or the first part found inside.
    for _, child in ipairs(Folder:GetChildren()) do
        local part
        if child:IsA("BasePart") then
            part = child
        elseif child:IsA("Model") then
            part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)
        else
            part = child:FindFirstChildWhichIsA("BasePart", true)
        end
        if part then table.insert(list, part) end
    end

    local root = GetRoot()
    if root then
        local pos = root.Position
        table.sort(list, function(a, b)
            return (a.Position - pos).Magnitude < (b.Position - pos).Magnitude
        end)
    end
    return list
end
local function TouchWithAllParts(Target)
    local char = GetChar()
    if not (char and firetouchinterest) then return end
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") and Target:IsDescendantOf(workspace) then
            firetouchinterest(part, Target, 0)
            firetouchinterest(part, Target, 1)
        end
    end
end
local function Collected(Candy, before)
    return (not Candy:IsDescendantOf(workspace)) or GetCandyValue() > before
end

-- Obsidian labels use :SetText, this wrapper keeps the old  label:Set("text")  style
local function Label(group, text)
    local l = group:AddLabel(text, true)
    return {
        Set = function(_, t) pcall(function() l:SetText(t) end) end,
    }
end

local function Notify(title, text, time)
    pcall(function()
        Library:Notify({ Title = title, Description = text, Time = time or 3 })
    end)
end

--------------------------------------------------------------------
-- CANDY COLLECT (teleport)
--------------------------------------------------------------------
local function TeleportToCandy(Candy)
    local before = GetCandyValue()
    local t = os.clock()
    while os.clock() - t < HoldTime do
        local Root = GetRoot()
        if Cancelled or not Root then return false end
        if GetCandyValue() >= MAX then return false end
        if Collected(Candy, before) then return true end
        Root.CFrame = Candy.CFrame
        Root.AssemblyLinearVelocity = Vector3.zero
        TouchWithAllParts(Candy)
        task.wait(0.05)
    end
    return Collected(Candy, before)
end

local Status
local function UpdateStatus(extra)
    if Status then
        local txt = "Candy Corn: " .. GetCandyValue() .. " / " .. MAX
        if extra then txt = txt .. " | " .. extra end
        Status:Set(txt)
    end
end

local function CollectAll()
    if Busy then return 0 end
    Busy = true
    Cancelled = false
    local startValue = GetCandyValue()
    local Root = GetRoot()
    local origin = Root and Root.CFrame

    local list = GetCandies()
    if #list == 0 then
        UpdateStatus("no candies found")
    end
    for i, Candy in ipairs(list) do
        if Cancelled or GetCandyValue() >= MAX or not GetRoot() then break end
        if Candy:IsDescendantOf(workspace) then
            UpdateStatus(i .. " / " .. #list)
            TeleportToCandy(Candy)
        end
        task.wait(Delay)
    end

    local R = GetRoot()
    if R and origin then
        R.CFrame = origin
        R.AssemblyLinearVelocity = Vector3.zero
    end
    UpdateStatus()
    Busy = false
    return GetCandyValue() - startValue
end

