local FarmBox = Tabs.SlapFarm:AddLeftGroupbox("Slapple farm")
local FarmOpts = Tabs.SlapFarm:AddRightGroupbox("Options")

local FarmMethod = "Teleport"
local TweenSpeed = 60        -- studs per second
local FarmHold = 0.4
local FarmReturn = true
local FarmBusy = false
local FarmCancelled = false
local FarmRunning = false
local FarmAutoId = 0
local ActiveTween
local FarmStatus = Label(FarmBox, "Status: idle")

local function Normalize(s) return (s:lower():gsub("[%s_%-]", "")) end

local function FindSlappleIsland()
    for _, child in ipairs(workspace:GetChildren()) do
        if Normalize(child.Name) == "slappleisland" then return child end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if Normalize(d.Name) == "slappleisland" then return d end
    end
end

local function FindSlapples()
    local island = FindSlappleIsland()
    if not island then return nil, nil end
    for _, d in ipairs(island:GetChildren()) do
        if Normalize(d.Name) == "slapples" then return d, island end
    end
    for _, d in ipairs(island:GetDescendants()) do
        if Normalize(d.Name) == "slapples" then return d, island end
    end
    return nil, island
end

local function GetSlappleList()
    local folder = FindSlapples()
    local list = {}
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") or item:IsA("BasePart") then table.insert(list, item) end
        end
    end
    return list
end

local function ItemPosition(item)
    if item:IsA("Model") then return item:GetPivot().Position end
    return item.Position
end

local function ItemParts(item)
    if item:IsA("BasePart") then return { item } end
    local list = {}
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(list, d) end
    end
    return list
end

-- triggers every way a pickup can work: click, prompt, touch
-- (touch is sent from every body part of your character, like the candy collector)
local function Interact(item)
    local root = GetRoot()
    if not root then return end
    local char = GetChar()
    local nodes = item:GetDescendants()
    table.insert(nodes, item)
    for _, d in ipairs(nodes) do
        if d:IsA("ClickDetector") and fireclickdetector then
            pcall(fireclickdetector, d)
        elseif d:IsA("ProximityPrompt") and fireproximityprompt then
            pcall(fireproximityprompt, d)
        elseif d:IsA("BasePart") and firetouchinterest and d.Parent then
            pcall(function()
                firetouchinterest(root, d, 0)
                firetouchinterest(root, d, 1)
            end)
            if char then
                for _, cp in ipairs(char:GetChildren()) do
                    if cp:IsA("BasePart") and cp ~= root then
                        pcall(function()
                            firetouchinterest(cp, d, 0)
                            firetouchinterest(cp, d, 1)
                        end)
                    end
                end
            end
        end
    end
end

local function InteractFor(item, seconds)
    local t = os.clock()
    repeat
        if FarmCancelled or not item.Parent then return end
        Interact(item)
        task.wait(0.08)
    until os.clock() - t >= seconds
end

-- METHOD 1: teleport
local function FarmTeleport(item)
    local root = GetRoot()
    if not root then return end
    root.CFrame = CFrame.new(ItemPosition(item) + Vector3.new(0, 3, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    InteractFor(item, FarmHold)
end

-- METHOD 2: bring the slapple to my character
-- Fix: the old version moved the slapple on your client only, so the server never
-- saw it near you. Now it (1) asks for network ownership so the move replicates,
-- (2) keeps it pinned on your character every frame, (3) touches it with every
-- body part, and (4) if it is still there afterwards, puts it back and falls
-- back to the teleport method so nothing gets skipped.
local function ClaimOwnership()
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "SimulationRadius", 1e9)
            sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 1e9)
        end
    end)
end

local function FarmBring(item)
    local root = GetRoot()
    if not root then return end

    local isModel = item:IsA("Model")
    local originalPivot = isModel and item:GetPivot() or item.CFrame
    local parts = ItemParts(item)
    local saved = {}
    for _, p in ipairs(parts) do
        saved[p] = { Anchored = p.Anchored, CanCollide = p.CanCollide }
        p.CanCollide = false
        p.CanTouch = true
        p.Anchored = false
    end

    ClaimOwnership()

    local t = os.clock()
    while os.clock() - t < FarmHold do
        root = GetRoot()
        if FarmCancelled or not root or not item.Parent then break end
        ClaimOwnership()
        local target = root.CFrame
        if isModel then item:PivotTo(target) else item.CFrame = target end
        for _, p in ipairs(parts) do
            if p.Parent then
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
        Interact(item)
        task.wait(0.03)
    end

    -- not picked up: put it back and use the reliable method instead
    if item.Parent and not FarmCancelled then
        for p, s in pairs(saved) do
            if p.Parent then
                p.Anchored = s.Anchored
                p.CanCollide = s.CanCollide
            end
        end
        if isModel then item:PivotTo(originalPivot) else item.CFrame = originalPivot end
        FarmTeleport(item)
    end
end

-- METHOD 3: tween (speed in studs/second)
local function FarmTween(item)
    local root = GetRoot()
    if not root then return end
    local target = CFrame.new(ItemPosition(item) + Vector3.new(0, 3, 0))
    local distance = (root.Position - target.Position).Magnitude
    local duration = math.max(distance / math.max(TweenSpeed, 1), 0.05)

    TweenNoclip = true
    ActiveTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = target })
    ActiveTween:Play()
    local t = os.clock()
    while ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing and os.clock() - t < duration + 1 do
        if FarmCancelled then ActiveTween:Cancel() break end
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait()
    end
    ActiveTween = nil
    TweenNoclip = false
    if not FarmCancelled then InteractFor(item, FarmHold) end
end

local FarmMethods = {
    ["Teleport"] = FarmTeleport,
    ["Bring"] = FarmBring,
    ["Tween"] = FarmTween,
}

local function FarmOnce()
    if FarmBusy then return 0 end
    FarmBusy = true
    FarmCancelled = false

    local folder, island = FindSlapples()
    if not island then
        FarmStatus:Set("Status: 'Slapple island' not found in workspace")
        FarmBusy = false
        return 0
    end
    if not folder then
        FarmStatus:Set("Status: 'Slapples' not found inside Slapple island")
        FarmBusy = false
        return 0
    end

    local root = GetRoot()
    local origin = root and root.CFrame
    local fn = FarmMethods[FarmMethod] or FarmTeleport
    local list = GetSlappleList()
    local done = 0

    for i, item in ipairs(list) do
        if FarmCancelled or not GetRoot() then break end
        if item.Parent then
            FarmStatus:Set(string.format("Status: %s | slapple %d / %d", FarmMethod, i, #list))
            fn(item)
            done += 1
            task.wait(0.05)
        end
    end

    TweenNoclip = false
    local R = GetRoot()
    if FarmReturn and R and origin then
        R.CFrame = origin
        R.AssemblyLinearVelocity = Vector3.zero
    end
    FarmStatus:Set("Status: done (" .. done .. " visited)")
    FarmBusy = false
    return done
end

FarmBox:AddDropdown("FarmMethod", {
    Text = "Method", Values = { "Teleport", "Bring", "Tween" }, Default = "Teleport", Multi = false,
    Callback = function(Option) FarmMethod = type(Option) == "table" and Option[1] or Option end,
