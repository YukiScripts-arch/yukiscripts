local LegoRunning = false
local LegoId = 0
local LegoCount = 0
local LegoStatus = Label(LegoBox, "Legos spawned: 0")

-- looks in the character first (tool equipped), then in the Backpack
local function FindBrickEvent()
    local containers = { GetChar(), LocalPlayer:FindFirstChild("Backpack") }
    for _, c in ipairs(containers) do
        local brick = c and c:FindFirstChild("Brick")
        local ev = brick and brick:FindFirstChild("Event")
        if ev then return ev end
    end
end

local function FireLego()
    local ev = FindBrickEvent()
    if not ev then return false end
    local ok = pcall(function() ev:FireServer("lego") end)
    if ok then
        LegoCount += 1
        LegoStatus:Set("Legos spawned: " .. LegoCount)
    end
    return ok
end

LegoBox:AddSlider("LegoInterval", {
    Text = "Spawn a lego every (s)", Default = 5, Min = 5, Max = 7, Rounding = 1,
    Callback = function(v) LegoInterval = v end,
})
LegoBox:AddToggle("LegoSpawn", {
    Text = "Auto spawn lego", Default = false,
    Callback = function(Value)
        LegoRunning = Value
        LegoId += 1
        local myId = LegoId
        if not Value then return end
        task.spawn(function()
            while LegoRunning and myId == LegoId do
                FireLego()
                local waited = 0
                while LegoRunning and myId == LegoId and waited < LegoInterval do
                    task.wait(0.1)
                    waited += 0.1
                end
            end
        end)
    end,
})
LegoBox:AddButton({ Text = "Spawn one lego now", Func = function() FireLego() end })

