local StatsLabel = Label(MiscBox, "FPS: ... | Ping: ...")
do
    local frames, last = 0, os.clock()
    RunService.RenderStepped:Connect(function()
        frames += 1
        local now = os.clock()
        if now - last >= 1 then
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            StatsLabel:Set("FPS: " .. frames .. " | Ping: " .. ping .. " ms")
            frames, last = 0, now
        end
    end)
end

