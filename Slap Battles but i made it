local TeleBoxIslands = Tabs.Teleports:AddLeftGroupbox("Islands")
local TeleBoxSelect = Tabs.Teleports:AddRightGroupbox("Pick and go")

local function TeleportTo(name, pos)
    local root = GetRoot()
    if not root then
        Notify("Teleports", "Character not found.")
        return
    end
    -- a few studs above the point so you don't spawn inside the floor
    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    Notify("Teleports", "Teleported to " .. name, 2)
end

local IslandNames = {}
local IslandPos = {}
for _, island in ipairs(Islands) do
    table.insert(IslandNames, island[1])
    IslandPos[island[1]] = island[2]
    TeleBoxIslands:AddButton({
        Text = island[1],
        Func = function() TeleportTo(island[1], island[2]) end,
    })
end

local SelectedIsland = IslandNames[1]
TeleBoxSelect:AddDropdown("TeleportIsland", {
    Text = "Island", Values = IslandNames, Default = 1, Multi = false,
    Callback = function(Value)
        SelectedIsland = type(Value) == "table" and Value[1] or Value
    end,
})
TeleBoxSelect:AddButton({
    Text = "Teleport to selected island",
    Func = function()
        local pos = IslandPos[SelectedIsland]
        if pos then TeleportTo(SelectedIsland, pos) end
    end,
})

