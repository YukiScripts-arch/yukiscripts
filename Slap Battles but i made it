local FeatureList = {}

local function NewFeature(applyFn)
    local f = { Enabled = false, Saved = setmetatable({}, { __mode = "k" }) }
    f.Set = function(inst, prop, value)
        local ok, current = pcall(function() return inst[prop] end)
        if not ok then return end
        local s = f.Saved[inst]
        if not s then s = {} f.Saved[inst] = s end
        if s[prop] == nil then s[prop] = current end
        pcall(function() inst[prop] = value end)
    end
    f.Apply = function(inst) applyFn(inst, f.Set) end
    table.insert(FeatureList, f)
    return f
end

local function RestoreFeature(f)
    for inst, props in pairs(f.Saved) do
        for prop, val in pairs(props) do pcall(function() inst[prop] = val end) end
    end
    f.Saved = setmetatable({}, { __mode = "k" })
end

local function EnableFeature(f)
    f.Enabled = true
    task.spawn(function()
        local n = 0
        for _, root in { workspace, Lighting } do
            for _, inst in ipairs(root:GetDescendants()) do
                if not f.Enabled then return end
                pcall(f.Apply, inst)
                n += 1
                if n % 1000 == 0 then task.wait() end
            end
        end
    end)
end

local function DisableFeature(f)
    f.Enabled = false
    RestoreFeature(f)
end

local function OnAdded(inst)
    for _, f in ipairs(FeatureList) do
        if f.Enabled then pcall(f.Apply, inst) end
    end
end
workspace.DescendantAdded:Connect(OnAdded)
Lighting.DescendantAdded:Connect(OnAdded)

local F_Textures = NewFeature(function(i, set)
    if i:IsA("Decal") or i:IsA("Texture") then set(i, "Transparency", 1) end
end)
local F_MeshTex = NewFeature(function(i, set)
    if i:IsA("MeshPart") then set(i, "TextureID", "") end
end)
local F_Materials = NewFeature(function(i, set)
    if i:IsA("BasePart") and not i:IsA("Terrain") then
        set(i, "Material", Enum.Material.SmoothPlastic)
        set(i, "Reflectance", 0)
    end
end)
local F_Shadows = NewFeature(function(i, set)
    if i:IsA("BasePart") then set(i, "CastShadow", false) end
end)
local F_Particles = NewFeature(function(i, set)
    if i:IsA("ParticleEmitter") or i:IsA("Trail") or i:IsA("Beam")
        or i:IsA("Fire") or i:IsA("Smoke") or i:IsA("Sparkles") then
        set(i, "Enabled", false)
    end
end)
local F_Effects = NewFeature(function(i, set)
    if i:IsA("PostEffect") then set(i, "Enabled", false)
    elseif i:IsA("Atmosphere") then set(i, "Density", 0) set(i, "Haze", 0)
    elseif i:IsA("Clouds") then set(i, "Enabled", false) end
end)
local F_Water = NewFeature(function() end)

local OptToggleIds = {}

local function FeatureToggle(id, name, f, extraOn, extraOff)
    GfxBox:AddToggle(id, {
        Text = name, Default = false,
        Callback = function(Value)
            if Value then
                EnableFeature(f)
                if extraOn then pcall(extraOn) end
            else
                DisableFeature(f)
                if extraOff then pcall(extraOff) end
            end
        end,
    })
    table.insert(OptToggleIds, id)
end

