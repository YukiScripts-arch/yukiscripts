    FillTransparency = 0.5,
    OutlineTransparency = 0,
    TeamCheck = false,
    UseTeamColor = false,
    AlwaysOnTop = true,
}

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "PlayerHighlights"
do
    local ok = pcall(function()
        ESPFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not ok then ESPFolder.Parent = workspace end
end

local ESPObjects = {}   -- [player] = Highlight

local function ESPRemove(plr)
    local h = ESPObjects[plr]
    if h then
        pcall(function() h:Destroy() end)
        ESPObjects[plr] = nil
    end
end

local function ESPUpdate(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    local hide = (not ESP.On) or (not char) or (not char.Parent)
    if not hide and ESP.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then hide = true end
    if hide then
        ESPRemove(plr)
        return
    end

    local h = ESPObjects[plr]
    if not h or not h.Parent then
        h = Instance.new("Highlight")
        h.Name = plr.Name
        h.Parent = ESPFolder
        ESPObjects[plr] = h
    end
    h.Adornee = char
    local fill, outline = ESP.Fill, ESP.Outline
    if ESP.UseTeamColor and plr.Team then
        fill = plr.TeamColor.Color
        outline = plr.TeamColor.Color
    end
    h.FillColor = fill
    h.OutlineColor = outline
    h.FillTransparency = ESP.FillTransparency
    h.OutlineTransparency = ESP.OutlineTransparency
    h.DepthMode = ESP.AlwaysOnTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
end

local function ESPRefresh()
    for _, plr in ipairs(Players:GetPlayers()) do ESPUpdate(plr) end
end

local function ESPHook(plr)
    plr.CharacterAdded:Connect(function() task.defer(ESPUpdate, plr) end)
    plr.CharacterRemoving:Connect(function() ESPRemove(plr) end)
end
for _, plr in ipairs(Players:GetPlayers()) do ESPHook(plr) end
Players.PlayerAdded:Connect(ESPHook)
Players.PlayerRemoving:Connect(ESPRemove)

