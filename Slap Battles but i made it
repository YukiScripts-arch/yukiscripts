-- VISUALS: NAMETAG CHANGER (client side only, other players still see your real name)
-- Changes the Humanoid display name and any overhead billboard text that shows your name.
--------------------------------------------------------------------
local Nametag = { On = false, Name = "" }
local NameSaved = setmetatable({}, { __mode = "k" })   -- [textObject] = original text

local function IsOwnName(text)
    return text == LocalPlayer.Name
        or text == LocalPlayer.DisplayName
        or text == "@" .. LocalPlayer.Name
end

local function ApplyNametag()
    if Nametag.Name == "" then return end
    local char = GetChar()
    if not char then return end

    local hum = GetHum()
    if hum and hum.DisplayName ~= Nametag.Name then
        pcall(function() hum.DisplayName = Nametag.Name end)
    end

    for _, d in ipairs(char:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton"))
            and d:FindFirstAncestorOfClass("BillboardGui") then
            if NameSaved[d] == nil and IsOwnName(d.Text) then
                NameSaved[d] = d.Text
            end
            if NameSaved[d] ~= nil and d.Text ~= Nametag.Name then
                d.Text = Nametag.Name
            end
        end
    end
end

local function RestoreNametag()
    for obj, text in pairs(NameSaved) do
        if obj.Parent then pcall(function() obj.Text = text end) end
        NameSaved[obj] = nil
    end
    local hum = GetHum()
    if hum then pcall(function() hum.DisplayName = LocalPlayer.DisplayName end) end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if Nametag.On then pcall(ApplyNametag) end
    end
end)

