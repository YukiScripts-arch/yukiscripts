local function FindSlapLabel()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local sc = gui and gui:FindFirstChild("SlapCount")
    if not sc then return nil end
    -- the game's LocalScript sits inside the label (script.Parent.Text = Slaps.Value)
    for _, d in ipairs(sc:GetDescendants()) do
        if d:IsA("LocalScript") and d.Parent
            and (d.Parent:IsA("TextLabel") or d.Parent:IsA("TextButton") or d.Parent:IsA("TextBox")) then
            return d.Parent
        end
    end
    for _, d in ipairs(sc:GetDescendants()) do
        if d:IsA("TextLabel") then return d end
    end
end

local function RealSlaps()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local s = ls and ls:FindFirstChild("Slaps")
    return s and s.Value or 0
end

local function FakeText()
    return string.format("%.0f", FakeSlaps.Value)
end

