local Settings = {
    Enabled = false,
    Mode = "Teleport",
    TweenSpeed = 150,
    DelayPerPlayer = 0.1,
    BlacklistedPlayers = {},
    BlacklistedTeams = {
        ["Guards"] = false,
        ["Prisoners"] = false,
        ["Criminals"] = false,
    },
}

local function getTeamName(plr)
    return plr.Team and plr.Team.Name or ""
end

local function moveToTarget(targetPart)
    local localHRP = getRoot()
    if not localHRP then return end

    if Settings.Mode == "Teleport" then
        localHRP.CFrame = targetPart.CFrame
    else
        local distance = (localHRP.Position - targetPart.Position).Magnitude
        local duration = distance / math.max(Settings.TweenSpeed, 1)
        local tween = TweenService:Create(localHRP, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetPart.CFrame })
        tween:Play()
        tween.Completed:Wait()
    end
end

