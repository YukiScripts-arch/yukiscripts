local aiming = false
local fovEnabled = false
local smoothness = 0.1
local fovRadius = 360
local aimPart = "Head"
local wallCheckEnabled = false
local fovColor = Color3.fromRGB(255, 0, 0)
local rainbowEnabled = false

local AimBlacklist = {
    Players = {},
    Teams = {
        ["Guards"] = false,
        ["Prisoners"] = false,
        ["Criminals"] = false,
    },
}

local fovCircle
if Drawing then
    fovCircle = Drawing.new("Circle")
    fovCircle.Thickness = 0.5
    fovCircle.NumSides = 64
    fovCircle.Filled = false
    fovCircle.Transparency = 1
    fovCircle.Visible = false
end

local function isVisible(targetPart)
    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { localPlayer.Character, camera }
    local result = workspace:Raycast(origin, direction, params)
    return not result or result.Instance:IsDescendantOf(targetPart.Parent)
end

local function getTarget()
    local closest, minDist = nil, fovRadius
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= localPlayer and char and char:FindFirstChild(aimPart)
            and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then

            if AimBlacklist.Players[p.Name] then continue end
            if p.Team and AimBlacklist.Teams[p.Team.Name] then continue end

            local part = char[aimPart]
            local pos, onScreen = camera:WorldToViewportPoint(part.Position)

            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < minDist then
                    if wallCheckEnabled and not isVisible(part) then
                        continue
                    end
                    minDist = dist
                    closest = part
                end
            end
        end
    end

    return closest
end

track(RunService.RenderStepped:Connect(function()
    camera = workspace.CurrentCamera

    if fovCircle then
        if rainbowEnabled then
            fovCircle.Color = Color3.fromHSV((tick() % 5) / 5, 1, 1)
        else
            fovCircle.Color = fovColor
        end
        fovCircle.Visible = fovEnabled
        fovCircle.Radius = fovRadius
        fovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    end

    if aiming then
        local target = getTarget()
        if target then
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, target.Position), smoothness)
        end
    end
end))

