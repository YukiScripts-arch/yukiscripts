-- Invisible
local InvisBox = Tabs.Player:AddRightGroupbox("Invisibility")

local isInvisible = false
local characterParts = {}

local function setupCharacter()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    character:WaitForChild("Humanoid")
    character:WaitForChild("HumanoidRootPart")
    characterParts = {}

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency == 0 then
            table.insert(characterParts, part)
        end
    end
end

local function setInvisibleState(state)
    isInvisible = state
    for _, part in ipairs(characterParts) do
        if part and part.Parent then
            part.Transparency = isInvisible and 0.5 or 0
        end
    end
end

task.spawn(setupCharacter)

track(localPlayer.CharacterAdded:Connect(function()
    isInvisible = false
    if Library.Toggles.Invisible then
        Library.Toggles.Invisible:SetValue(false)
    end
    setupCharacter()
end))

track(RunService.Heartbeat:Connect(function()
    if not isInvisible then return end

    local rootPart = getRoot()
    local humanoid = getHumanoid()
    if not (rootPart and humanoid) then return end

    local oldCFrame = rootPart.CFrame
    local oldCameraOffset = humanoid.CameraOffset

    local targetCFrame = oldCFrame * CFrame.new(0, -75, 0)
    local offset = targetCFrame:ToObjectSpace(CFrame.new(oldCFrame.Position)).Position

    rootPart.CFrame = targetCFrame
    humanoid.CameraOffset = offset

    RunService.RenderStepped:Wait()

    rootPart.CFrame = oldCFrame
    humanoid.CameraOffset = oldCameraOffset
end))

InvisBox:AddToggle("Invisible", {
    Text = "Enable invisible",
    Default = false,
    Callback = function(v)
        setInvisibleState(v)
    end,
